+bool GSDeviceVK::DoAntiFlicker(GSTexture* history, GSTexture* dTex, const float params[8])
+{
+	if (m_antiflicker_pipeline == VK_NULL_HANDLE)
+		return false;
+
+	const GSVector4 sRect = GSVector4(0.0f, 0.0f, 1.0f, 1.0f);
+	const GSVector4i dRect = dTex->GetRect();
+	EndRenderPass();
+
+	// The history was just written by CopyRect(); make it sampleable before the render pass begins.
+	GSTextureVK* const history_vk = static_cast<GSTextureVK*>(history);
+	history_vk->SetUseFenceCounter(GetCurrentFenceCounter());
+	history_vk->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+
+	OMSetRenderTargets(dTex, nullptr, dRect);
+	SetUtilityTexture(history, m_point_sampler);
+	BeginRenderPass(m_utility_color_render_pass_discard, dRect);
+	dTex->SetState(GSTexture::State::Dirty);
+	SetPipeline(m_antiflicker_pipeline);
+	SetUtilityPushConstants(params, sizeof(float) * 8);
+	DrawStretchRect(sRect, GSVector4(dRect), dTex->GetSize());
+	EndRenderPass();
+
+	static_cast<GSTextureVK*>(dTex)->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+	return true;
+}
